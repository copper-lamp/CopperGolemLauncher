{
  "name": "copper-core",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "description": "铜傀儡启动器 · 铜核心项目入口（转发到 frontend/，Rust 后端在 src-tauri/）",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:preview": "tauri dev --config src-tauri/tauri.preview.conf.json",
    "tauri:build:preview": "tauri build --config src-tauri/tauri.preview.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
